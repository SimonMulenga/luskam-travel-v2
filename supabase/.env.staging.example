# Copy to supabase/.env.staging.local. Replace placeholders with staging-only credentials.
# Supabase injects SUPABASE_URL and legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# in hosted Edge Functions; never put service-role values in the Vite file.
# FlightAPI is the pricing provider. Disable the schedule fallback by default
# so a failed fare request cannot trigger a second FlightAPI call.
FLIGHT_PROVIDER=none
FLIGHT_BOOKING_PROVIDER=none
FLIGHTAPI_KEY=<STAGING_FLIGHTAPI_CREDENTIAL>
BOOKING_ALLOWED_ORIGINS=<EXACT_HTTPS_STAGING_PREVIEW_ORIGIN>

# Optional comma-separated exact HTTPS origins to add to the flight-search CORS
# allowlist. Staging and local development origins are built in.
# FLIGHT_SEARCH_ALLOWED_ORIGINS=https://additional-preview.example

# Add only if the related function/provider is intentionally enabled:
# AVIATIONSTACK_API_KEY=<STAGING_AVIATIONSTACK_CREDENTIAL>
# DUFFEL_API_KEY=<STAGING_DUFFEL_CREDENTIAL>
# LOVABLE_API_KEY=<STAGING_LOVABLE_AI_CREDENTIAL>
